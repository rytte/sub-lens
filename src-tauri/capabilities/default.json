{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main, settings, ocr-region and subtitle-explain windows",
  "windows": ["main", "settings", "ocr-region", "subtitle-explain"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-hide",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "opener:default"
  ]
}
